# Backend API Environment Variables Example

PORT=5000
NODE_ENV=production
# Production: https://sqm-system-web.vercel.app
# Local: http://localhost:3000
FRONTEND_URL=https://sqm-system-web.vercel.app

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Admin Seed Account
ADMIN_USER=admin@example.com
ADMIN_PASS=admin_password_here

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email
EMAIL_PASS=your_email_app_password
EMAIL_FROM=your_email@example.com
